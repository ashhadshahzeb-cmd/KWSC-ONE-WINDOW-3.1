SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Multiple numbers separated by commas (format: [country_code][number]@c.us)
TARGET_PHONE_NUMBERS="923001234567@c.us,923111111111@c.us"

# Daily Digest Cron Schedule (Default: 0 17 * * * => 5:00 PM PKT every day)
CRON_DIGEST_SCHEDULE="0 17 * * *"

# Number of days before a pending file is marked as "Delayed/Stuck"
DELAYED_THRESHOLD_DAYS=3
